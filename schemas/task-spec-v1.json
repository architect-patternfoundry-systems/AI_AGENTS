{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agents.patternfoundry.dev/schemas/task-spec-v1.json",
  "title": "Task Specification v1",
  "description": "Compact YAML task assignment consumed by the agent-invoke composer.",
  "type": "object",
  "required": ["schema_version", "title", "mode", "scope", "acceptance_criteria"],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "title": {"type": "string"},
    "mode": {"type": "string", "enum": ["assess", "implement", "fix", "infra", "security", "review"]},
    "agent_profile": {"type": "string"},
    "scope": {
      "type": "object",
      "required": ["repositories"],
      "properties": {
        "repositories": {"type": "array", "items": {"type": "string"}},
        "paths": {"type": "array", "items": {"type": "string"}},
        "permitted_operations": {"type": "array", "items": {"type": "string"}},
        "prohibited_operations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  }
}
